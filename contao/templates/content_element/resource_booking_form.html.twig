{% extends "@Contao/content_element/_base.html.twig" %}
{% trans_default_domain 'huh_rb' %}

{% set root_attrs = attrs()
    .set('data-huhrb-root', js_root_data|default|json_encode)
    .set('class', 'rb-loading')
    .mergeWith(root_attrs|default)
%}

{% set mount_attrs = attrs()
    .set('id', mount_id|default)
    .set('class', 'rb-calendar')
    .mergeWith(mount_attrs|default)
%}

{% set main_attrs = attrs()
    .set('data-rb-if', '(!loading)')
    .set('class', 'rb-main')
    .mergeWith(main_attrs|default)
%}

{% set loader_attrs = attrs()
    .set('data-rb-if', '(loading)')
    .mergeWith(loader_attrs|default)
%}

{% set importmap = {
    "imports": {
        "@huh/rb": asset('assets/js/index.js', 'huh_rb_build'),
        "@huh/rb/calendar": asset('assets/js/calendar.js', 'huh_rb_build'),
    }
} %}

{% block content %}
    {% if disabled|default(false) %}
        {{ block('disabled') }}
    {% else %}
        {{ block('enabled') }}
    {% endif %}
{% endblock %}

{% block disabled %}
    <p>Aktuell ist keine Buchung möglich.</p>
{% endblock %}

{% block enabled %}
    <div {{ root_attrs }}>

        {% block root_start %}{% endblock %}

        <div {{ main_attrs }}>
            {{ include(mount_template, {
                attributes: mount_attrs,
                mount_id: mount_id,
                booking_archive: booking_archive,
                resource_archives: resource_archives,
                resources: resources,
            }) }}

            {{ include('@Contao/resource_booking/haste_form.html.twig', { data: haste_form }) }}
        </div>

        <div {{ loader_attrs }}>
            {% block loading %}
                <p>{{ 'messages.form_loading'|trans|raw }}</p>
            {% endblock %}
        </div>

        <template data-rb-template="error">
            {% block template_general_error %}
                <p>{{ 'messages.general_error'|trans|raw }}</p>
            {% endblock %}
        </template>

        <template data-rb-template="error-loading">
            {% block template_form_loading_error %}
                <p>{{ 'messages.form_loading_error'|trans|raw }}</p>
            {% endblock %}
        </template>

        <template data-rb-template="select-dates">
            {%- block template_select_dates -%}
                <div class="rb-no-dates-picked">{{ 'messages.select_dates'|trans|raw }}</div>
            {%- endblock -%}
        </template>

        <template data-rb-template="invalid-dates">
            {%- block template_invalid_dates -%}
                <div class="rb-invalid-dates">{{ 'messages.invalid_dates'|trans|raw }}</div>
            {%- endblock -%}
        </template>

        <template data-rb-message="error-submission-empty">
            {%- block template_submission_empty -%}
                {{ 'messages.submission_empty'|trans|raw }}
            {%- endblock -%}
        </template>

        <template data-rb-message="error-submission-no-range">
            {%- block template_submission_no_range -%}
                {{ 'messages.submission_no_range'|trans|raw }}
            {%- endblock -%}
        </template>

        {% block root_end %}{% endblock %}

    </div>
{% endblock %}

{% block script %}
    {% add 'huh_rb_form' to head %}

        <link rel="stylesheet" href="{{ asset('style.css', 'huh_rb_build') }}">
        <script type="importmap">{{ importmap|json_encode|raw }}</script>
        <script type="module">import "@huh/rb";</script>
    {% endadd %}
{% endblock %}
