{% extends "@Contao/content_element/_base.html.twig" %}

{% set root_attrs = attrs()
    .set('data-huhrb-root', js_root_data|json_encode)
    .set('class', 'rb-loading')
    .mergeWith(root_attrs|default)
%}

{% set mount_attrs = attrs()
    .set('id', mount_id)
    .mergeWith(mount_attrs|default)
%}

{% set importmap = {
    "imports": {
        "@huh/rb": asset('assets/js/index.js', 'huh_rb_build'),
        "@huh/rb/calendar": asset('assets/js/calendar.js', 'huh_rb_build'),
    }
} %}

{% block content %}
    {% if disabled|default(false) %}
        {{ block('disabled') }}
    {% else %}
        {{ block('enabled') }}
    {% endif %}
{% endblock %}

{% block disabled %}
    <p>Aktuell ist keine Buchung möglich.</p>
{% endblock %}

{% block enabled %}
    <div {{ root_attrs }}>

        <div data-rb-if="(!loading)" class="rb-main">
            {{ include(mount_template, {
                attributes: mount_attrs,
                mount_id: mount_id,
            }) }}

            {{ include('@Contao/resource_booking/haste_form.html.twig', {
                data: haste_form,
                submit: 'Buchen'
            }) }}
        </div>

        <div data-rb-if="(loading)" class="rb-loader">
            {% block loading %}
                {{ 'messages.loading_form'|trans({}, 'huh_rb')|raw }}
            {% endblock %}
        </div>

        <template data-rb-template="error">
            {% block template_error %}
                <p>Fehler beim Buchen.</p>
            {% endblock %}
        </template>

        {% block root_end %}{% endblock %}

    </div>
{% endblock %}

{% block script %}
    {% add 'huh_rb_form' to head %}

        <link rel="stylesheet" href="{{ asset('style.css', 'huh_rb_build') }}">
        <script type="importmap">{{ importmap|json_encode|raw }}</script>
        <script type="module">import "@huh/rb";</script>
    {% endadd %}
{% endblock %}
