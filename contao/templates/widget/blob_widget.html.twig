{% trans_default_domain 'huh_rb' %}
<div class="blob-widget">
    {% if data == null %}
        <p>Keine Daten.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Datum</th>
                    <th>Wert</th>
                </tr>
            </thead>
            <tbody>
            {% for key, value in data %}
                <tr>
                    <td>{{ ('booking_data.' ~ key)|trans }}</td>
                    <td>{{ value }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
<style>
    .blob-widget {
        margin-top: .5rem;

        table {
            width: 100%;
            border-collapse: collapse;
            border-spacing: 0;
            th, td {
                padding: .5rem .75rem;
            }

            tbody tr:nth-child(odd) {
                background-color: #aaaaaa22;
            }
        }
    }
</style>