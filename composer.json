{
    "name": "heimrichhannot/contao-resource-booking-bundle",
    "type": "contao-bundle",
    "description": "Book and manage resource objects with this bundle for Contao Open Source CMS.",
    "license": "LGPL-3.0-or-later",
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "contao/core-bundle": "^5.0",
        "doctrine/dbal": "^2.13 || ^3.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "symfony/config": "^6.0 || ^7.0",
        "symfony/dependency-injection": "^6.0 || ^7.0",
        "symfony/event-dispatcher-contracts": "^1.0 || ^2.0 || ^3.0",
        "symfony/filesystem": "^6.0 || ^7.0",
        "symfony/http-foundation": "^6.0 || ^7.0",
        "symfony/http-kernel": "^6.0 || ^7.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "contao/test-case": "^4.0 || ^5.0",
        "contao/manager-plugin": "^2.0",
        "heimrichhannot/contao-test-utilities-bundle": "^0.1",
        "phpunit/phpunit": "^8.0 || ^9.0",
        "php-coveralls/php-coveralls": "^2.0",
        "symfony/phpunit-bridge": "^6.0 || ^7.0",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-symfony": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "HeimrichHannot\\ResourceBookingBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HeimrichHannot\\ResourceBookingBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            "contao-components/installer": true,
            "contao/manager-plugin": true,
            "php-http/discovery": false
        }
    },
    "extra": {
        "contao-manager-plugin": "HeimrichHannot\\ResourceBookingBundle\\ContaoManager\\Plugin"
    }
}
